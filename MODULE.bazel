module(
    name = "tracks",
    version = "2.0.0",
)

# This archived Ruby release includes MRI 2.2.10 and its OpenSSL 1.0.2 libs.
# Its absolute CA certificate symlinks are excluded from the Bazel runfiles.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "ruby_2_2_10",
    build_file_content = 'filegroup(name = "runtime", srcs = glob(["bin/ruby", "lib/**", "openssl/lib/**"], exclude = ["openssl/ssl/cert.pem", "openssl/ssl/certs"]), visibility = ["//visibility:public"])',
    sha256 = "71cf8c2d4b42a9fcddd1a09edff8f107dcb5772b4180c89fa04b63b8288b97a7",
    strip_prefix = "x64",
    urls = ["https://github.com/ruby/ruby-builder/releases/download/ruby-2.2.10/ruby-2.2.10-ubuntu-22.04-x64.tar.gz"],
)
